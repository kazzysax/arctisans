# Arctisans: copy to .env.local and fill in. Never commit real values.
APP_SECRET=            # >= 32 random chars (openssl rand -hex 32). Signs sessions, encrypts agent key secrets.
CRON_SECRET=           # random; protects /api/cron/index
DATABASE_URL=file:./local.db   # Neon/Turso URL in production
DATABASE_AUTH_TOKEN=
RPC_URL=https://rpc.mainnet.arc.io
ESCROW_ADDRESS=        # set after deploy
SOCIAL_ADDRESS=        # set after deploy
START_BLOCK=           # block of deployment, for the indexer
CIRCLE_API_KEY=        # Circle Console (mainnet key)
NEXT_PUBLIC_CIRCLE_APP_ID=
PINATA_JWT=            # optional in dev (local disk fallback)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
